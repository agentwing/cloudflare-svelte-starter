{
	"name": "cloudflare-svelte-starter",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
	  "node": ">=22",
	  "pnpm": ">=9"
	},
	"scripts": {
		"dev": "vite dev --host 127.0.0.1",
		"worker:dev": "wrangler dev",
		"build": "wrangler types --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"test": "pnpm test:unit && pnpm test:e2e",
		"test:e2e": "playwright test",
		"db:migrate:local": "wrangler d1 migrations apply cloudflare-svelte-starter --local",
		"verify": "wrangler types && prettier --check . && eslint . && wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vitest run && vite build"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.27.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"clsx": "^2.1.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.4.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"better-auth": "^1.6.25",
		"svelte-i18n": "^4.0.1"
	},
	"pnpm": {
		"overrides": {
			"cookie": "^0.7.2",
			"esbuild": "^0.25.0"
		}
	}
}
